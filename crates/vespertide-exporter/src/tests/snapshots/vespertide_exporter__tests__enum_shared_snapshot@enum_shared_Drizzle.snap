export const docStatus = pgEnum("doc_status", ["draft", "published", "archived"]);

export const documents = pgTable("documents", {
  id: integer("id").primaryKey(),
  status: docStatus("status").notNull(),
  reviewStatus: docStatus("review_status"),
});
