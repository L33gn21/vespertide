export const compositeIndex = pgTable("composite_index", {
  id: integer("id").primaryKey(),
  tenantId: integer("tenant_id").notNull(),
  name: text("name").notNull(),
}, (t) => ({
  idxTenantName: index("idx_tenant_name").on(t.tenantId, t.name),
}));
