export const unnamedIndex = pgTable("unnamed_index", {
  id: integer("id").primaryKey(),
  colA: integer("col_a").notNull(),
  colB: integer("col_b").notNull(),
}, (t) => ({
  idxColAColB: index().on(t.colA, t.colB),
}));
