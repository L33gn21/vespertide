export const compositeUnique = pgTable("composite_unique", {
  id: integer("id").primaryKey(),
  tenantId: integer("tenant_id").notNull(),
  name: text("name").notNull(),
}, (t) => ({
  uqTenantName: unique("uq_tenant_name").on(t.tenantId, t.name),
}));
